# SmarterVote Local Development Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# REQUIRED: LLM Provider
# =============================================================================

# OpenRouter - Required for all LLM calls
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# =============================================================================
# REQUIRED: Web Search
# =============================================================================

# Serper.dev - Required for web search during research
# Get your key at: https://serper.dev/
SERPER_API_KEY=your-serper-key-here

# =============================================================================
# PIPELINE CONFIGURATION
# =============================================================================

# Cost-saving mode: Use gpt-5-mini instead of gpt-5.4
# Set to "true" for local development to save API costs
SMARTERVOTE_CHEAP_MODE=true

# =============================================================================
# CACHING CONFIGURATION (optional)
# =============================================================================

# Search cache TTL in hours (defaults to 168 = 7 days)
# SEARCH_CACHE_TTL_HOURS=168

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Skip Auth0 token verification for local development.
# NEVER set this in a deployed environment.
SKIP_AUTH=true

# Python path (auto-set by dev-start.ps1)
# PYTHONPATH=.

# =============================================================================
# PRODUCTION SETTINGS (not needed for local dev)
# =============================================================================

# Google Cloud Project (for deployed services)
# GCP_PROJECT_ID=your-project-id

# GCS bucket for race data — set this to push published races to GCS from
# your local pipeline so the deployed races-api immediately serves fresh data.
# Find your bucket name in the GCP console or Terraform output (sv_data_bucket_name).
# Requires: pip install google-cloud-storage  +  gcloud auth application-default login
# GCS_BUCKET_NAME=your-project-id-sv-data-production

# Auth0 (web authentication, production only)
# AUTH0_SECRET=your-auth0-secret
# AUTH0_BASE_URL=http://localhost:5173
# AUTH0_ISSUER_BASE_URL=https://your-domain.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
