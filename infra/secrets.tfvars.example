# Example secrets file for Terraform variables
# Copy this file to secrets.tfvars and fill in your actual values.
# DO NOT commit secrets.tfvars to version control.

# Google Cloud Project Configuration
project_id  = "your-gcp-project-id"
region      = "us-central1"
environment = "dev"  # dev, staging, or prod

# AI Agent API Keys (required)
openrouter_api_key = "sk-or-your-openrouter-api-key"
serper_api_key     = "your-serper-api-key"
searlo_api_key     = "your-searlo-api-key"
jina_api_key       = "your-jina-api-key"

# Races API admin key - protects /analytics/* endpoints (leave empty to disable auth)
admin_api_key = ""

# Cloudflare Web Analytics. The site tag is also the public beacon token.
cloudflare_analytics_api_token = ""
cloudflare_analytics_account_tag = ""

# Stripe payment keys (leave empty until payments are ready to open)
# Use sk_test_... / whsec_... for testing; sk_live_... / whsec_... for production
stripe_secret_key     = ""
stripe_webhook_secret = ""
cloudflare_analytics_site_tag = ""

# Firestore: set true only on first deploy in a brand-new project (requires Owner/Editor).
# Leave false if the (default) database already exists.
create_firestore_database = false

# Pipeline Client Authentication (optional)
auth0_domain   = "your-auth0-domain"
auth0_audience = "your-auth0-audience"
allowed_origins = ["http://localhost:5173"]

# Developer GCP identities for local service account impersonation (e.g. for MCP)
developer_gcp_identities = [
  "user:developer@example.com"
]
