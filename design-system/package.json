{
  "name": "@smartervote/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone React component library replicating SmarterVote's visual identity, for import into claude.ai/design. Not used by the production SvelteKit app.",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/styles/globals.css -o dist/index.css --minify",
    "build": "npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
