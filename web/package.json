{
  "name": "smartervote-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build --mode fast",
    "build:crawl": "npm run generate:sitemap && vite build --mode crawl",
    "build:fast": "vite build --mode fast",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "build:cloudflare": "npm run generate:sitemap && npm run build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin=prettier-plugin-svelte --check . && eslint .",
    "format": "prettier --plugin=prettier-plugin-svelte --write .",
    "test:unit": "svelte-kit sync && vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@testing-library/svelte": "5.4.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^26.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.20.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.6",
    "svelte-check": "4.7.3",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.4.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "type": "module",
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.23.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/table-core": "8.21.3",
    "autoprefixer": "^10.5.4",
    "chart.js": "^4.5.1",
    "d3-geo": "^3.1.1",
    "postcss": "^8.5.19",
    "svelte-chartjs": "4.0.1",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.0",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
