{
  "name": "smartervote-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build --mode fast",
    "build:crawl": "npm run generate:sitemap && vite build --mode crawl",
    "build:fast": "vite build --mode fast",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "build:cloudflare": "npm run generate:sitemap && npm run build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin=prettier-plugin-svelte --check . && eslint .",
    "format": "prettier --plugin=prettier-plugin-svelte --write .",
    "test:unit": "svelte-kit sync && vitest run",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "5.4.2",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.4.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "2.46.1",
    "jsdom": "30.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.4.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "type": "module",
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.24.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/table-core": "8.21.3",
    "autoprefixer": "^10.5.4",
    "chart.js": "^4.5.1",
    "d3-geo": "^3.1.1",
    "postcss": "^8.5.26",
    "svelte-chartjs": "4.0.1",
    "tailwindcss": "^3.4.19",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.0",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
